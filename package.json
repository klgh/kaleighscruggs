{
  "name": "klgh-garden",
  "version": "4.0.0",
  "description": "my digital garden",
  "keywords": [
    "digital garden"
  ],
  "homepage": "https://github.com/klgh/kaleighscruggs#readme",
  "bugs": {
    "url": "https://github.com/klgh/kaleighscruggs/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/klgh/kaleighscruggs.git"
  },
  "license": "MIT",
  "author": "Kaleigh Scruggs",
  "type": "module",
  "scripts": {
    "prebuild": "yarn generate:sitemap",
    "build": "vite build",
    "build:dev": "vite build --mode development",
    "dev": "vite",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "lint": "eslint '**/*.{ts,vue}' --fix",
    "prepare": "husky install",
    "prettier": "prettier '**/*.{ts,vue,json,md}' --write",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,vue}": [
      "eslint --fix",
      "eslint"
    ],
    "*.json": [
      "prettier --write --ignore-unknown"
    ],
    "*.md": [
      "prettier --write --ignore-unknown"
    ]
  },
  "browserslist": [
    "> 0.25%",
    "not dead"
  ],
  "dependencies": {
    "@lucide/vue": "^1.34.0",
    "marked": "^15.0.12",
    "vue": "^3.5.41",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "husky": "^8.0.3",
    "jsdom": "^20.0.3",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^9.4.3",
    "vue-tsc": "^2.2.12"
  },
  "packageManager": "yarn@4.18.0"
}
